{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": false,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "dist",
    "noEmitOnError": true,
    "types": []
  },
  "files": ["node_modules/onnxruntime-web/types.d.ts"],
  "include": ["src/**/*.ts"]
}
